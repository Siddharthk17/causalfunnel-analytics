PORT=4000
MONGODB_URI=mongodb://localhost:27017/causalfunnel
# Comma-separated origins for the dashboard. Unset = allow all (fine for local review).
# CORS_ORIGIN=http://localhost:5173
# Connection attempts before giving up. Set to 1 on serverless, where a cold
# start must fail fast instead of retrying until the function times out.
# DB_CONNECT_ATTEMPTS=6
# MONGO_POOL_SIZE=5
# MONGO_TIMEOUT_MS=8000